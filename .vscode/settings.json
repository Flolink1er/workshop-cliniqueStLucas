{
  "[html]": {
    "editor.defaultFormatter": "dbaeumer.vscode-eslint"
  },
  "[typescript]": {
    "editor.defaultFormatter": "dbaeumer.vscode-eslint"
  },
  "css.lint.unknownAtRules": "ignore",
  "editor.codeActionsOnSave": {
    "source.addMissingImports.ts": "explicit",
    "source.fixAll.prettier": "explicit",
    "source.fixAll.ts": "explicit",
    "source.organizeImports": "explicit",
    // "source.removeUnused.ts": "explicit",
    "source.removeUnusedImports": "explicit"
  },
  "explorer.fileNesting.enabled": true,
  "explorer.fileNesting.patterns": {
    "*.ts": "${capture}.html, ${capture}.scss",
    "package.json": "package-lock.json, .editorconfig, eslint.*, angular.json, .postcssrc.json, .prettierrc*",
    "tsconfig.json": "tsconfig.*.json"
  },
  "workbench.colorCustomizations": {
    "[Vira*]": {
      "tab.activeBorder": "#ff669e5c",
      "tab.activeModifiedBorder": "#ff669e"
    }
  }
}
